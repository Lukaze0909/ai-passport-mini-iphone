# AI Passport Mini iPhone — server settings
# Copy to .env (next to gateway.py) or point PASSPORT_ENV_FILE at your file.
# Variables already set in the environment win over this file.
# Relative paths are relative to this server/ directory.

# ---------------------------------------------------------------- device / MQTT
# The device's MQTT username; topics are <PASSPORT_TOPIC_PREFIX>/<PASSPORT_DEVICE_ID>/...
# (status, event, audio from the device; command, weather, playchunk to it).
PASSPORT_DEVICE_ID=passport-1
PASSPORT_TOPIC_PREFIX=passport

# Broker the gateway and passportctl connect to. Usually the same machine, so
# plain 1883 on localhost is fine; the device itself talks TLS (8883) to the
# broker's public listener (see README).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=passport-gateway
MQTT_PASS=change-me
MQTT_CLIENT_ID=passport-gateway
# Set MQTT_TLS=1 if the gateway connects to a TLS listener (e.g. a remote broker).
MQTT_TLS=0
# CA bundle for that TLS listener (empty = system CAs).
MQTT_CA_FILE=
# Only for testing with self-signed certs: skip hostname verification.
MQTT_TLS_INSECURE=0

# ---------------------------------------------------------------- state / time
# Where the gateway keeps clips, audio, game state, status.json, weather.json.
PASSPORT_STATE_DIR=./state
# Time zone for the Bingo card day (06:00 -> 06:00) and timestamps.
# "+08:00"-style offset or an IANA name ("Europe/Berlin"). Must match the
# time zone configured in the device firmware.
PASSPORT_TZ=+08:00
# How long `say` audio files and incoming voice clips are kept (seconds).
PASSPORT_AUDIO_TTL_S=3600
PASSPORT_CLIP_KEEP_S=259200

# ---------------------------------------------------------------- audio to the device (passportctl say)
# Audio format the firmware expects: adpcm (IMA ADPCM, default) or pcm (s16le 16 kHz).
PASSPORT_AUDIO_FMT=adpcm
# How the device receives it: mqtt (chunks on <dev>/playchunk, needs adpcm) or http.
PASSPORT_AUDIO_VIA=mqtt
# For http: the gateway serves /passport-audio/<token> on HTTP_BIND:HTTP_PORT; put it
# behind a TLS reverse proxy and set the public prefix here (ending in /passport-audio/).
HTTP_BIND=127.0.0.1
HTTP_PORT=8006
AUDIO_ORIGIN=https://passport.example.com/passport-audio/

# ---------------------------------------------------------------- companion hook
# Every event for the companion (voice clip, minesweeper turn, Bingo, astro roll) is
# piped as one JSON object to this command's stdin, one at a time. Exit code 0 = delivered.
# Leave empty to append events to PASSPORT_OUTBOX instead (one JSON per line) and let
# your agent tail that file.
COMPANION_HOOK_CMD=
COMPANION_HOOK_TIMEOUT_S=900
PASSPORT_OUTBOX=./state/outbox.jsonl
# How event hints refer to the CLI (put the passportctl wrapper on PATH, or use a full path).
PASSPORT_CTL=passportctl

# ---------------------------------------------------------------- speech to text
# sensevoice = local SenseVoice via sherpa-onnx (pip install sherpa-onnx numpy)
# openai     = any OpenAI-compatible /v1/audio/transcriptions endpoint
# none       = no transcription (events carry only the audio path)
PASSPORT_ASR=sensevoice
# Transcribe Call / Messages voice clips before handing them to the companion.
PASSPORT_TRANSCRIBE_VOICE=1
# SenseVoice model files (a sherpa-onnx SenseVoice release, e.g.
# sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17).
SENSEVOICE_MODEL=./models/sensevoice/model.int8.onnx
SENSEVOICE_TOKENS=./models/sensevoice/tokens.txt
SENSEVOICE_LANGUAGE=auto
SENSEVOICE_THREADS=2
# OpenAI-compatible transcription (used when PASSPORT_ASR=openai).
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=
ASR_TIMEOUT_S=90
# Drop transcripts where one short phrase repeats back to back at least this many
# times and fills most of the text (a known Whisper-style hallucination).
ASR_REPEAT_MIN=4

# ---------------------------------------------------------------- Notes app (memo one-liner)
# Any OpenAI-compatible chat endpoint. Empty base URL = send the transcript itself
# when it is plain ASCII, else "?".
MEMO_LLM_BASE_URL=https://api.openai.com/v1
MEMO_LLM_API_KEY=
MEMO_LLM_MODEL=gpt-4o-mini
MEMO_LLM_MAX_TOKENS=60
MEMO_LLM_TIMEOUT_S=30
# Example: MiniMax's OpenAI-compatible endpoint (check your account region and model list)
# MEMO_LLM_BASE_URL=https://api.minimax.io/v1
# MEMO_LLM_MODEL=MiniMax-Text-01

# ---------------------------------------------------------------- text to speech (passportctl say)
# openai  = any OpenAI-compatible /v1/audio/speech endpoint
# minimax = MiniMax t2a_v2 (example of a non-OpenAI API)
TTS_PROVIDER=openai
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEED=1.0
# MiniMax example:
# TTS_PROVIDER=minimax
# TTS_BASE_URL=https://api.minimax.io
# TTS_MODEL=speech-2.6-hd
# TTS_VOICE=your-voice-id
# MINIMAX_GROUP_ID=
# Or replace TTS completely: any command taking ("text" out-file) and writing audio ffmpeg can read.
TTS_CMD=

# ---------------------------------------------------------------- weather app
# Empty latitude/longitude = weather disabled. Open-Meteo needs no key.
WEATHER_LAT=
WEATHER_LON=
# Label shown on the device (the device font may not contain every glyph).
WEATHER_CITY=
WEATHER_EVERY_S=900
# AQI: open-meteo (no key, US AQI), waqi (needs a token from aqicn.org), or none.
AQI_SOURCE=open-meteo
AQI_WAQI_TOKEN=
# waqi station, e.g. "@1234" or a city slug; empty = nearest to WEATHER_LAT/LON.
AQI_WAQI_STATION=

# ---------------------------------------------------------------- Bingo
# Task pool (labels, fixed cells, auto rules, fallback whispers).
BINGO_TASKS_FILE=./examples/bingo_tasks.example.json
# Optional check-in log that ticks the "auto" labels: JSONL lines like
# {"t": "2026-01-01T07:30:00+08:00", "tag": "wake"} (tags set in the task file).
# Empty = no automatic ticks.
PASSPORT_CHECKINS_FILE=

# ---------------------------------------------------------------- minesweeper
# How long the end-of-game event waits for the owner's layout to arrive.
PASSPORT_MINES_END_WAIT_S=3.0
